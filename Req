import pandas as pd
from functools import reduce

# List of all five category DataFrames
category_dfs = [
    category1,
    category2,
    category3,
    category4,
    category5
]

# Merge all categories using customer_id
final_df = reduce(
    lambda left, right: pd.merge(
        left,
        right,
        on="customer_id",
        how="outer",
        validate="one_to_one"
    ),
    category_dfs
)

# Fill missing derived feature values with 0
feature_cols = [
    col for col in final_df.columns
    if col != "customer_id"
]

final_df[feature_cols] = final_df[feature_cols].fillna(0)

# Check for duplicate customer IDs
assert final_df["customer_id"].is_unique, \
    "Duplicate customer IDs found!"

# Verify feature count
print("Final dataset shape:", final_df.shape)
print("Unique customers:", final_df["customer_id"].nunique())
print("Derived variables:", len(feature_cols))

# Save final dataset
final_df.to_excel(
    "Customer_Derived_Variables.xlsx",
    index=False,
    engine="openpyxl"
)

final_df.to_csv(
    "Customer_Derived_Variables.csv",
    index=False
)

print("\nFiles saved successfully!")
print("1. Customer_Derived_Variables.xlsx")
print("2. Customer_Derived_Variables.csv")

