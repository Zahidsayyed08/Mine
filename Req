# Extract year and day type
txn_df['Year'] = txn_df['Transaction_Date'].dt.year

txn_df['Day_Type'] = txn_df['Transaction_Date'].dt.dayofweek.apply(
    lambda x: 'Weekend' if x >= 5 else 'Weekday'
)

# Calculate daily transaction volume
daily_volume = txn_df.groupby(
    ['Year', 'Transaction_Date', 'Day_Type']
)['Transaction_Amount'].sum().reset_index()

# Calculate average daily volume
q3_result = daily_volume.groupby(
    ['Year', 'Day_Type']
)['Transaction_Amount'].mean().unstack()

print(q3_result)




import matplotlib.pyplot as plt

q3_result.plot(kind='bar', figsize=(12, 6))

plt.title('Average Transaction Volume: Weekday vs Weekend')
plt.xlabel('Year')
plt.ylabel('Average Transaction Volume')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()



