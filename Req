txn_type_mapping = {
    'a_casac_txn': 'CASA Credit',
    'a_casad_txn': 'CASA Debit',
    'a_emi_pymt': 'CASA EMI',
    'a_tax_pymt': 'CASA Tax',
    'a_int_txn': 'CASA Interest'
}

txn_df['Transaction_Category'] = txn_df['Transaction_Type'].map(
    txn_type_mapping
)


q8_result = pd.crosstab(
    txn_df['Transaction_Category'],
    txn_df['Year']
)

print(q8_result)


import matplotlib.pyplot as plt

q8_result.T.plot(
    kind='bar',
    figsize=(14, 7)
)

plt.title('Year-wise Transaction Count by Transaction Category')
plt.xlabel('Year')
plt.ylabel('Number of Transactions')

plt.legend(title='Transaction Category')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
