account_region = (
    cli_df[['Account_ID', 'Client_ID', 'Region']]
    .drop_duplicates(subset='Account_ID')
)



total_customers = (
    cli_df.groupby('Region')['Client_ID']
    .nunique()
    .reset_index(name='# Customers')
)

total_accounts = (
    acc_df.groupby('Account_ID')
    .first()
    .reset_index()[['Account_ID']]
    .merge(
        account_region[['Account_ID', 'Region']],
        on='Account_ID',
        how='left'
    )
    .groupby('Region')['Account_ID']
    .nunique()
    .reset_index(name='# Accounts')
)


txn_region = txn_df.merge(
    account_region[['Account_ID', 'Region']],
    on='Account_ID',
    how='left'
)

dashboard_channel = pd.crosstab(
    txn_region['Region'],
    txn_region['Transaction_Channel']
)

channels = [
    'Branches',
    'Paynamics',
    'Pesonet',
    'Visa',
    'Mastercard'
]

dashboard_channel = dashboard_channel.reindex(
    columns=channels,
    fill_value=0
)

dashboard_channel.columns = [
    '# Transactions ' + col for col in dashboard_channel.columns
]

dashboard_9 = (
    total_customers
    .merge(total_accounts, on='Region', how='outer')
    .merge(
        dashboard_channel.reset_index(),
        on='Region',
        how='outer'
    )
)

# Replace missing values with zero
dashboard_9 = dashboard_9.fillna(0)

# Convert all count columns to integer
count_cols = dashboard_9.columns.drop('Region')

dashboard_9[count_cols] = dashboard_9[count_cols].astype(int)

# Display final dashboard
dashboard_9
