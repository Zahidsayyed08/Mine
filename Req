import pandas as pd
import numpy as np

# Clean column names
df.columns = df.columns.str.strip()

# Ensure relevant columns exist
required_cols = [
    "customer_id", "sms_date", "direction",
    "category", "sub_category", "merchant", "upi_app"
]

missing_cols = [c for c in required_cols if c not in df.columns]

if missing_cols:
    raise ValueError(f"Missing required columns: {missing_cols}")

# Prepare data
df["sms_date"] = pd.to_datetime(
    df["sms_date"], errors="coerce"
)

for col in [
    "customer_id", "direction", "category",
    "sub_category", "merchant", "upi_app"
]:
    df[col] = df[col].fillna("").astype(str).str.strip()

# Normalize text for classification
df["direction"] = df["direction"].str.upper()
df["category_lower"] = df["category"].str.lower()
df["subcategory_lower"] = df["sub_category"].str.lower()

# Identify transaction records
transaction_mask = df["direction"].isin(["DR", "CR"])

# UPI transaction records
upi_mask = (
    transaction_mask
    & (
        df["category_lower"].str.contains(r"\bupi\b", regex=True)
        | df["subcategory_lower"].str.contains(r"\bupi\b", regex=True)
        | df["upi_app"].str.strip().ne("")
    )
)

# Restrict temporal features to transaction records
transactions = df.loc[transaction_mask].copy()

transactions["transaction_date"] = (
    transactions["sms_date"].dt.date
)

transactions["transaction_hour"] = (
    transactions["sms_date"].dt.hour
)

transactions["late_night_flag"] = (
    transactions["transaction_hour"].between(0, 4)
)

# Identify distinct merchants and channels
merchant_values = df["merchant"].str.strip()

valid_merchant = (
    merchant_values.ne("")
    & ~merchant_values.str.lower().isin(
        ["nan", "none", "unknown", "na", "n/a"]
    )
)

merchant_df = df.loc[valid_merchant]

channel_values = df["upi_app"].str.strip()

valid_channel = (
    channel_values.ne("")
    & ~channel_values.str.lower().isin(
        ["nan", "none", "unknown", "na", "n/a"]
    )
)

channel_df = df.loc[valid_channel]

# Aggregate features per customer
category5 = df.groupby("customer_id").size().to_frame(
    "total_sms_records"
)

category5["upi_transaction_count"] = (
    upi_mask.groupby(df["customer_id"]).sum()
)

category5["distinct_merchant_count"] = (
    merchant_df.groupby("customer_id")["merchant"]
    .nunique()
)

category5["active_days"] = (
    transactions.dropna(subset=["transaction_date"])
    .groupby("customer_id")["transaction_date"]
    .nunique()
)

category5["late_night_transaction_count"] = (
    transactions.groupby("customer_id")["late_night_flag"]
    .sum()
)

category5["distinct_payment_channels"] = (
    channel_df.groupby("customer_id")["upi_app"]
    .nunique()
)

# Fill missing counts with zero
category5 = category5.fillna(0).reset_index()

# Remove the helper column; keep only the five derived variables
category5 = category5.drop(columns=["total_sms_records"])

# Display results only — no files saved
display(category5.head(10))

print("Customers:", category5["customer_id"].nunique())
print("Category 5 variables:", len(category5.columns) - 1)
