import pandas as pd
from pathlib import Path

# Input and output file paths
input_file = Path("SMS_Data.txt")
output_file = Path("SMS_Data_Cleaned.xlsx")

# Read tab-separated data, skipping the first 60 metadata lines
df = pd.read_csv(
    input_file,
    sep="\t",
    skiprows=60,
    dtype=str,
    encoding="utf-8",
    on_bad_lines="warn"
)

# Clean column names
df.columns = df.columns.str.strip()

# Remove extra spaces from text columns
for col in df.select_dtypes(include=["object", "string"]).columns:
    df[col] = df[col].str.strip()

# Remove completely empty rows and columns
df = df.dropna(how="all").dropna(axis=1, how="all")

# Remove rows with no customer ID
if "customer_id" in df.columns:
    df = df[
        df["customer_id"].notna()
        & df["customer_id"].ne("")
    ]

# Remove exact duplicate rows
df = df.drop_duplicates().reset_index(drop=True)

print("Cleaning completed!")
print("Dataset shape:", df.shape)
print("Columns:", df.columns.tolist())

display(df.head())





# Convert date column to datetime
if "sms_date" in df.columns:
    df["sms_date"] = pd.to_datetime(
        df["sms_date"],
        errors="coerce"
    )

# Convert amount to numeric
if "amount" in df.columns:
    df["amount"] = pd.to_numeric(
        df["amount"].str.replace(",", "", regex=False),
        errors="coerce"
    )

# Save cleaned data to Excel
df.to_excel(
    output_file,
    index=False,
    engine="openpyxl"
)

print(f"Excel file saved successfully: {output_file.resolve()}")
print("Total rows:", len(df))
print("Total columns:", len(df.columns))






check_df = pd.read_excel("SMS_Data_Cleaned.xlsx")

display(check_df.head())
print("Verified shape:", check_df.shape)
print("Missing values:\n", check_df.isnull().sum())
