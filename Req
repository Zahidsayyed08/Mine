import pandas as pd
import numpy as np

# Clean column names
df.columns = df.columns.str.strip()

# Required columns
required_cols = [
    "customer_id", "category", "sub_category",
    "direction", "purpose", "sms_text"
]

missing_cols = [c for c in required_cols if c not in df.columns]

if missing_cols:
    raise ValueError(f"Missing required columns: {missing_cols}")

# Normalize text fields
text_cols = [
    "customer_id", "category", "sub_category",
    "direction", "purpose", "sms_text"
]

for col in text_cols:
    df[col] = df[col].fillna("").astype(str).str.strip()

df["direction"] = df["direction"].str.upper()

# Combine relevant fields for keyword matching
search_cols = ["category", "sub_category", "purpose", "sms_text"]

search_text = (
    df[search_cols]
    .agg(" ".join, axis=1)
    .str.lower()
)

# 1. Low-balance alerts
low_balance_mask = search_text.str.contains(
    r"low balance|insufficient balance|"
    r"balance below|minimum balance|"
    r"insufficient funds",
    regex=True,
    na=False
)

# 2. Loan offers
loan_offer_mask = (
    search_text.str.contains(
        r"loan offer|pre-approved loan|"
        r"instant loan|personal loan offer|"
        r"eligible for loan|apply for loan",
        regex=True,
        na=False
    )
)

# 3. BNPL / Pay Later transactions
bnpl_mask = (
    search_text.str.contains(
        r"\bbnpl\b|buy now pay later|"
        r"pay later|postpaid purchase",
        regex=True,
        na=False
    )
    & df["direction"].isin(["DR", "CR"])
)

# 4. Refund messages
refund_mask = search_text.str.contains(
    r"\brefund\b|\brefunded\b|"
    r"refund processed|amount reversed",
    regex=True,
    na=False
)

# 5. ATM cash withdrawals
atm_mask = (
    search_text.str.contains(
        r"\batm\b",
        regex=True,
        na=False
    )
    & search_text.str.contains(
        r"withdraw|cash dispensed|cash withdrawal",
        regex=True,
        na=False
    )
    & df["direction"].eq("DR")
)

# Aggregate counts by customer
category4 = df.groupby("customer_id").size().to_frame(
    "_temporary_count"
)

category4["low_balance_alert_count"] = (
    low_balance_mask.groupby(df["customer_id"]).sum()
)

category4["loan_offer_message_count"] = (
    loan_offer_mask.groupby(df["customer_id"]).sum()
)

category4["bnpl_transaction_count"] = (
    bnpl_mask.groupby(df["customer_id"]).sum()
)

category4["refund_message_count"] = (
    refund_mask.groupby(df["customer_id"]).sum()
)

category4["atm_withdrawal_count"] = (
    atm_mask.groupby(df["customer_id"]).sum()
)

# Keep only the five derived variables and customer ID
category4 = category4.drop(
    columns="_temporary_count"
).reset_index()

# Display results only — no files saved
display(category4.head(10))

print("Customers:", category4["customer_id"].nunique())
print("Category 4 variables:", len(category4.columns) - 1)
