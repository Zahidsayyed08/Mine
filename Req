import numpy as np

# Convert narration to lowercase
narration = txn_df['Transaction_Narration'].str.lower()

# Identify transaction channel
conditions = [
    narration.str.contains('brankas|brancask', na=False),
    narration.str.contains('paynamics', na=False),
    narration.str.contains('pesonet', na=False),
    narration.str.contains('visa', na=False),
    narration.str.contains('mastercard', na=False)
]

choices = [
    'Brankas',
    'Paynamics',
    'Pesonet',
    'Visa',
    'Mastercard'
]

# Create new column
txn_df['Transaction Channel'] = np.select(
    conditions,
    choices,
    default='Other'
)


