# Convert transaction date into datetime
txn_df['Transaction_Date'] = pd.to_datetime(
    txn_df['Transaction_Date']
)

# Sort transactions by date and time
txn_df = txn_df.sort_values(
    ['Transaction_Date', 'Transaction_time']
)

# Get latest net balance for each account
balance_df = (
    txn_df.dropna(subset=['Net_Balance'])
    .drop_duplicates(subset='Account_ID', keep='last')
    [['Account_ID', 'Net_Balance']]
)

# Merge into account-level dataframe
acc_df = acc_df.drop(columns=['Balance_Today'], errors='ignore')

acc_df = acc_df.merge(
    balance_df,
    on='Account_ID',
    how='left'
)

# Rename Net_Balance to Balance_Today
acc_df.rename(
    columns={'Net_Balance': 'Balance_Today'},
    inplace=True
)

# Accounts without transactions = 0
acc_df['Balance_Today'] = acc_df['Balance_Today'].fillna(0)
