import pandas as pd
import numpy as np

# Clean column names
df.columns = df.columns.str.strip()

# Normalize relevant text columns
text_cols = [
    "customer_id", "category", "sub_category",
    "direction", "purpose", "sms_text"
]

for col in text_cols:
    if col in df.columns:
        df[col] = df[col].fillna("").astype(str).str.strip()

# Convert amount to numeric
df["amount"] = pd.to_numeric(df["amount"], errors="coerce")

# Combine text fields for classification
text_fields = [
    c for c in ["category", "sub_category", "purpose", "sms_text"]
    if c in df.columns
]

df["_search_text"] = (
    df[text_fields].agg(" ".join, axis=1).str.lower()
)

# Identify relevant messages
utility_mask = df["_search_text"].str.contains(
    r"\butility\b|\belectricity\b|\bwater bill\b|"
    r"\bgas bill\b|\btelephone bill\b|\bbroadband\b|"
    r"\butility bill\b",
    regex=True,
    na=False
)

# Prefer explicit payment labels rather than bill reminders
utility_payment_mask = (
    utility_mask
    & df["_search_text"].str.contains(
        r"\bpaid\b|\bpayment successful\b|\bbill payment\b|"
        r"\bpayment received\b|\bpayment debited\b",
        regex=True,
        na=False
    )
)

nach_bounce_mask = df["_search_text"].str.contains(
    r"\bnach\b.*\b(bounce|failed|failure|return|returned)\b|"
    r"\b(bounce|failed|failure|return|returned)\b.*\bnach\b",
    regex=True,
    na=False
)

emi_reminder_mask = df["_search_text"].str.contains(
    r"\bemi\b.*\b(reminder|due|pay|payment|overdue)\b|"
    r"\b(reminder|due|pay|payment|overdue)\b.*\bemi\b",
    regex=True,
    na=False
)

collection_notice_mask = df["_search_text"].str.contains(
    r"\b(collection notice|collection agent|"
    r"debt collection|recovery notice|"
    r"payment recovery|loan recovery)\b",
    regex=True,
    na=False
)

# Aggregate features by customer
category3 = df.groupby("customer_id").agg(
    _placeholder=("customer_id", "size")
).drop(columns="_placeholder")

category3["utility_payment_count"] = (
    utility_payment_mask.groupby(df["customer_id"]).sum()
)

# Count only successful/identified utility payments with valid amounts
category3["total_utility_payment_amount"] = (
    df["amount"].where(
        utility_payment_mask & df["amount"].ge(0), 0
    ).groupby(df["customer_id"]).sum()
)

category3["nach_bounce_count"] = (
    nach_bounce_mask.groupby(df["customer_id"]).sum()
)

category3["emi_reminder_count"] = (
    emi_reminder_mask.groupby(df["customer_id"]).sum()
)

category3["collection_notice_count"] = (
    collection_notice_mask.groupby(df["customer_id"]).sum()
)

category3 = category3.fillna(0).reset_index()

# Display results only; do not save files
display(category3.head(10))

print("Customers:", category3["customer_id"].nunique())
print("Category 3 variables:", len(category3.columns) - 1)
