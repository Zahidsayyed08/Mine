account_volume = txn_df.groupby(
    ['Year', 'Account_ID']
)['Transaction_Amount'].sum().reset_index()

account_volume.rename(
    columns={'Transaction_Amount': 'Total_Volume'},
    inplace=True
)


import numpy as np
import pandas as pd

bins = [
    0,
    500000,
    1000000,
    1500000,
    2000000,
    2500000,
    np.inf
]

labels = [
    '0-500000',
    '500000-1000000',
    '1000000-1500000',
    '1500000-2000000',
    '2000000-2500000',
    '2500000+'
]

account_volume['Volume_Bin'] = pd.cut(
    account_volume['Total_Volume'],
    bins=bins,
    labels=labels,
    right=False
)


q6_result = pd.crosstab(
    account_volume['Volume_Bin'],
    account_volume['Year']
)

print(q6_result)



q6_result.T.plot(
    kind='bar',
    stacked=True,
    figsize=(14, 7)
)

