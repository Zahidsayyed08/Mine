import pandas as pd
import numpy as np

# Rank ADB in descending order
acc_df['ADB_Rank'] = acc_df['ADB_Jan2022'].rank(
    method='first',
    ascending=False
)

# Divide into 5 groups
acc_df['ADB_Decile'] = pd.qcut(
    acc_df['ADB_Rank'],
    q=5,
    labels=[
        'ADB Balance Decile 1',
        'ADB Balance Decile 2',
        'ADB Balance Decile 3',
        'ADB Balance Decile 4',
        'ADB Balance Decile 5'
    ]
)

# Check output
acc_df[
    ['Account_ID', 'ADB_Jan2022', 'ADB_Rank', 'ADB_Decile']
].head(20)


dashboard_accounts = pd.crosstab(
    acc_df['ADB_Decile'],
    acc_df['CDD Status']
)

# Keep required order
dashboard_accounts = dashboard_accounts.reindex(
    index=[
        'ADB Balance Decile 1',
        'ADB Balance Decile 2',
        'ADB Balance Decile 3',
        'ADB Balance Decile 4',
        'ADB Balance Decile 5'
    ],
    columns=['SDD', 'EDD', 'MEDD'],
    fill_value=0
)

dashboard_accounts.index.name = 'ADB Balance'
dashboard_accounts.columns.name = None

dashboard_accounts


