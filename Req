import pandas as pd
import numpy as np

# Convert KYC Date into datetime
acc_df['KYC_date'] = pd.to_datetime(
    acc_df['KYC_date'], errors='coerce'
)

# Normalize categorical columns
acc_df['KYC Status'] = acc_df['KYC Status'].astype(str).str.strip().str.upper()

acc_df['CDD Status'] = acc_df['CDD Status'].astype(str).str.strip().str.upper()

acc_df['FRM Status'] = pd.to_numeric(
    acc_df['FRM Status'], errors='coerce'
)

# Today's date
today = pd.Timestamp.today().normalize()

# Default CDD Due Date
acc_df['CDD Due Date'] = pd.NaT

# Active account conditions
conditions = [
    (acc_df['KYC Status'] == 'ACTIVE') &
    (acc_df['CDD Status'] == 'SDD') &
    (acc_df['FRM Status'] == 0),

    (acc_df['KYC Status'] == 'ACTIVE') &
    (acc_df['CDD Status'] == 'SDD') &
    (acc_df['FRM Status'] == 1),

    (acc_df['KYC Status'] == 'ACTIVE') &
    (acc_df['CDD Status'] == 'EDD') &
    (acc_df['FRM Status'] == 0),

    (acc_df['KYC Status'] == 'ACTIVE') &
    (acc_df['CDD Status'] == 'EDD') &
    (acc_df['FRM Status'] == 1),

    (acc_df['KYC Status'] == 'ACTIVE') &
    (acc_df['CDD Status'] == 'MEDD') &
    (acc_df['FRM Status'] == 0),

    (acc_df['KYC Status'] == 'ACTIVE') &
    (acc_df['CDD Status'] == 'MEDD') &
    (acc_df['FRM Status'] == 1)
]

# Corresponding years
years = [5, 4, 4, 3, 2, 1]

# Calculate due dates
for condition, year in zip(conditions, years):

    acc_df.loc[condition, 'CDD Due Date'] = (
        acc_df.loc[condition, 'KYC_date']
        + pd.DateOffset(years=year)
    )

# Dormant and Expired accounts: Due today
acc_df.loc[
    acc_df['KYC Status'].isin(['DORMANT', 'EXPIRED']),
    'CDD Due Date'
] = today
