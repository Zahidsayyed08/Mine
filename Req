import pandas as pd
import numpy as np

# Load cleaned dataset
df = pd.read_excel("SMS_Data_Cleaned.xlsx")

# Clean column names and categorical values
df.columns = df.columns.str.strip()

for col in ["customer_id", "direction"]:
    df[col] = df[col].astype("string").str.strip()

df["direction"] = df["direction"].str.upper()
df["amount"] = pd.to_numeric(df["amount"], errors="coerce")

# Identify valid debit and credit records
valid_amount = df["amount"].notna() & (df["amount"] >= 0)

debit_mask = df["direction"].eq("DR") & valid_amount
credit_mask = df["direction"].eq("CR") & valid_amount

# Create transaction amount columns
df["debit_amount"] = df["amount"].where(debit_mask, 0)
df["credit_amount"] = df["amount"].where(credit_mask, 0)

# Derive Category 1 variables
category1 = df.groupby("customer_id").agg(
    total_debit_amount=("debit_amount", "sum"),
    total_credit_amount=("credit_amount", "sum"),
    avg_debit_amount=(
        "amount",
        lambda x: x[debit_mask.loc[x.index]].mean()
    ),
    debit_transaction_count=(
        "direction", lambda x: x.eq("DR").sum()
    )
).reset_index()

# Credit-to-debit ratio
category1["credit_to_debit_ratio"] = (
    category1["total_credit_amount"]
    / category1["total_debit_amount"].replace(0, np.nan)
)

# Display results only — no files saved
display(category1.head(10))

print("Customers:", category1["customer_id"].nunique())
print("Derived variables:", len(category1.columns) - 1)
