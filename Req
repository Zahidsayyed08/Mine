# Create Account_ID and Client_ID mapping
account_client = cli_df[
    ['Account_ID', 'Client_ID']
].drop_duplicates()

# Merge account-level CDD status with Client_ID
temp_df = acc_df[
    ['Account_ID', 'CDD Status']
].merge(
    account_client,
    on='Account_ID',
    how='left'
)

# Clean CDD Status
temp_df['CDD Status'] = (
    temp_df['CDD Status']
    .astype(str)
    .str.strip()
    .str.upper()
)

# Function to calculate client CDD status
def get_cdd_status(x):

    if 'MEDD' in x.values:
        return 'MEDD'

    elif 'EDD' in x.values:
        return 'EDD'

    else:
        return 'SDD'


# Calculate CDD Status at Client level
client_cdd_status = (
    temp_df.groupby('Client_ID')['CDD Status']
    .apply(get_cdd_status)
    .reset_index(name='CDD_Status')
)

# Update cli_df
cli_df = cli_df.drop(
    columns=['CDD_Status'],
    errors='ignore'
)

cli_df = cli_df.merge(
    client_cdd_status,
    on='Client_ID',
    how='left'
)



# Merge account-level KYC status with Client_ID
temp_kyc = acc_df[
    ['Account_ID', 'KYC Status']
].merge(
    account_client,
    on='Account_ID',
    how='left'
)

# Clean KYC Status
temp_kyc['KYC Status'] = (
    temp_kyc['KYC Status']
    .astype(str)
    .str.strip()
    .str.upper()
)

# Function to calculate client KYC status
def get_kyc_status(x):

    if 'ACTIVE' in x.values:
        return 'Active'

    elif 'DORMANT' in x.values:
        return 'Dormant'

    else:
        return 'Expired'


# Calculate KYC Status at Client level
client_kyc_status = (
    temp_kyc.groupby('Client_ID')['KYC Status']
    .apply(get_kyc_status)
    .reset_index(name='KYC_Status')
)

# Update cli_df
cli_df = cli_df.drop(
    columns=['KYC_Status'],
    errors='ignore'
)

cli_df = cli_df.merge(
    client_kyc_status,
    on='Client_ID',
    how='left'
)





# Count unique accounts for each client
client_ppc = (
    account_client.groupby('Client_ID')['Account_ID']
    .nunique()
    .reset_index(name='PPC')
)

# Update cli_df
cli_df = cli_df.drop(
    columns=['PPC'],
    errors='ignore'
)

cli_df = cli_df.merge(
    client_ppc,
    on='Client_ID',
    how='left'
)

cli_df['PPC'] = cli_df['PPC'].fillna(0).astype(int)



