account_volume = txn_df.groupby('Account_ID')['Transaction_Amount'].sum().reset_index()

account_volume.columns = ['Account_ID', 'Total_Transaction_Volume']

account_volume.head()

# Create 5 transaction volume categories
account_volume['Volume_Range'] = pd.qcut(
    account_volume['Total_Transaction_Volume'],
    q=5,
    labels=['Very Low', 'Low', 'Medium', 'High', 'Very High'],
    duplicates='drop'
)


q6_result = account_volume['Volume_Range'].value_counts(sort=False)

print(q6_result)


import matplotlib.pyplot as plt

plt.figure(figsize=(10, 6))

q6_result.plot(kind='bar')

plt.title('Distribution of Accounts Across Transaction Volumes')
plt.xlabel('Transaction Volume Category')
plt.ylabel('Number of Accounts')

plt.xticks(rotation=0)
plt.tight_layout()
plt.show()
