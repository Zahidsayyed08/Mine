credit_types = ['a_casac_txn', 'a_int_txn']

debit_types = ['a_casad_txn', 'a_emi_pymt', 'a_tax_pymt']

txn_df['Credit'] = txn_df['Transaction_Amount'].where(
    txn_df['Transaction_Type'].isin(credit_types), 0
)

txn_df['Debit'] = txn_df['Transaction_Amount'].where(
    txn_df['Transaction_Type'].isin(debit_types), 0
)

account_balance = txn_df.groupby('Account_ID').agg(
    Total_Credit=('Credit', 'sum'),
    Total_Debit=('Debit', 'sum')
).reset_index()

account_balance['Net_Balance'] = (
    account_balance['Total_Credit'] -
    account_balance['Total_Debit']
)

account_balance['Rank'] = account_balance['Net_Balance'].rank(
    method='dense',
    ascending=False
).astype(int)


account_balance['Decile'] = pd.qcut(
    account_balance['Rank'],
    q=5,
    labels=[
        'Decile 1',
        'Decile 2',
        'Decile 3',
        'Decile 4',
        'Decile 5'
    ]
)


q11_result = account_balance.groupby(
    'Decile',
    observed=False
).agg(
    Account_Count=('Account_ID', 'count'),
    Average_Net_Balance=('Net_Balance', 'mean'),
    Total_Net_Balance=('Net_Balance', 'sum')
)

print(q11_result)
