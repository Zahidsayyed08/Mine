total_customers = (
    cli_df.groupby('Region')['Client_ID']
    .nunique()
    .reset_index(name='Total Customers')
)
total_accounts = (
    acc_df.merge(
        cli_df[['Account_ID', 'Region']].drop_duplicates('Account_ID'),
        on='Account_ID',
        how='left'
    )
    .groupby('Region')['Account_ID']
    .nunique()
    .reset_index(name='Total Accounts')
)
# Create account-region mapping
account_region = (
    cli_df[['Account_ID', 'Region']]
    .drop_duplicates('Account_ID')
)

# Merge region into transaction data
txn_region = txn_df.merge(
    account_region,
    on='Account_ID',
    how='left'
)

# Count transactions region-wise
total_transactions = (
    txn_region.groupby('Region')
    .size()
    .reset_index(name='Total Transactions')
)
dashboard_9 = (
    total_customers
    .merge(total_accounts, on='Region', how='outer')
    .merge(total_transactions, on='Region', how='outer')
)

# Replace missing values with zero
dashboard_9 = dashboard_9.fillna(0)

# Convert counts to integer
count_cols = [
    'Total Customers',
    'Total Accounts',
    'Total Transactions'
]

dashboard_9[count_cols] = (
    dashboard_9[count_cols].astype(int)
)

dashboard_9

