# Dense rank: highest net balance gets rank 1
account_balance['Rank'] = account_balance['Net_Balance'].rank(
    method='dense',
    ascending=False
).astype(int)

print(account_balance.head())


account_balance['Decile'] = pd.qcut(
    account_balance['Rank'],
    q=5,
    labels=[
        'Decile 1',
        'Decile 2',
        'Decile 3',
        'Decile 4',
        'Decile 5'
    ]
)

q11_result = account_balance.groupby(
    'Decile',
    observed=False
).agg(
    Account_Count=('Account_ID', 'count'),
    Average_Net_Balance=('Net_Balance', 'mean'),
    Total_Net_Balance=('Net_Balance', 'sum')
)

print(q11_result)


import matplotlib.pyplot as plt

q11_result['Account_Count'].plot(
    kind='bar',
    figsize=(10, 6)
)

plt.title('Distribution of Accounts Across Net Balance Groups')
plt.xlabel('Net Balance Groups')
plt.ylabel('Number of Accounts')
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()


